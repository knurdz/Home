# Copy to .env.local for local dev (optional). Vercel / Appwrite Site build env must match for static assets.
NEXT_PUBLIC_USE_APPWRITE_STATIC=1
NEXT_PUBLIC_APPWRITE_USE_PREVIEW=1
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=uom

# Join-us API (Knurdz Appwrite project — keep separate from static/uom)
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=697b8f42002a34ba04b3
# APPWRITE_API_KEY=              # Knurdz project — databases + server routes
# APPWRITE_DATABASE_ID=
# APPWRITE_COLLECTION_ID=

# upload:static script (uom bucket)
APPWRITE_STATIC_BUCKET_ID=site-static
